+#!/opt/svpgs-venv/bin/python
+"""GOLD and shipped reference: public-only best-of-family PGS estimator.
+
+This exact executable is both the packageable score-1 witness and the program the
+corpus builder executes to produce its reference anchors. It is not a trusted
+wrapper: it reads only the public task files and imports only its adjacent
+``pgs_core.py`` plus NumPy. Consequently score 1 is defined by executable source
+that an agent can actually submit; there is no hidden engine to imitate.
+
+Model. Covariates + intercept enter unpenalized. Every standardized genotype
+enters a single JOINT penalized logistic fit -- joint is what resolves LD, which
+is exactly what a marginal/clumping shortcut cannot do. Variant j carries prior
+variance
+
+    tau_j^2 = global^2 * s_j^2 * exp(gamma . a_j) * lambda_j
+
+with (a) s_j a class scale read through the FRACTIONAL class membership when the
+metadata carries one (so a 0.6/0.4 variant is priced at the blended scale, which
+a hard classifier cannot do), (b) gamma a coefficient vector over the continuous
+annotations named by the formula, and (c) lambda_j a heavy-tailed local
+shrinkage factor. All of it is estimated by empirical Bayes from
+E[beta_j^2] = beta_j^2 + posterior variance -- no hyperparameter is hand-set.
+
+Engineering (this is load-bearing, not incidental). At the shipped shape
+p (~2500) EXCEEDS n_train (~1800), so the textbook (p x p) normal-equation solve
+is both singular-prone and far too slow for the fit budget. Every inner solve
+therefore runs in the n-dimensional DUAL via Woodbury:
+
+    (G' W G + D)^-1  applied through  D^-1 - D^-1 G' (W^-1 + G D^-1 G')^-1 G D^-1
+
+which turns a p^3 solve into an n^3 one (~2500^3 -> ~1800^3, a ~2.7x cut) and is
+exact, not an approximation. The same factorization yields the posterior-variance
+diagonal EB needs, so the hyperparameter updates cost no extra decomposition.
+Dense near-Gaussian architectures are the important counter-regime: a plain
+joint ridge is the right estimator there.  The submission therefore reproduces
+the public best-of-family selection protocol around its independent estimators:
+compare this hierarchical estimator with a fixed-grid ridge on a deterministic,
+stratified inner split of the training
+rows; ridge must win AUC by 0.03. A positive-slope Platt map learned from the
+selected candidate's inner-validation logits calibrates its probability scale
+without changing its ranking, then the winner is refit on every training row.
+Family selection and calibration use no test input and are serialized into
+``model.out``.
+
+A wall-clock guard covers selection AND refit, not merely the winning refit.
+That accounting is load-bearing: a family selector that needs longer than the
+program's fit phase is not a reproducible model.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+import time
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from pgs_core import (  # noqa: E402
+    FAMILY_WIN_MARGIN,
+    RIDGE_PENALTIES,
+    auc,
+    build_class_design,
+    build_membership,
+    continuous_annotation,
+    deterministic_stratified_inner_split,
+    fit_platt_calibrator,
+    fit_ridge_logistic,
+    linear_predict,
+    load_covariates,
+    load_genotypes,
+    load_metadata,
+    parse_formula,
+    standardize,
+)
+
+T0 = time.monotonic()
+# The public phase cap is 170 seconds.  Selection must finish early enough to leave
+# a real full-refit budget, and the whole estimator must leave room to serialize.
+# Missing either reserve fails closed instead of silently dropping a family arm.
+INNER_HIERARCHICAL_DEADLINE_S = 60.0
+SELECTION_DEADLINE_S = 100.0
+FIT_COMPUTE_DEADLINE_S = 158.0
+FIT_BUDGET_S = 165.0
+HIERARCHICAL_OUTER_ITERATIONS = 6
+
+
+def _elapsed() -> float:
+    return time.monotonic() - T0
+
+
+def main() -> None:
+    family = open("family.txt").read().strip()
+    if family != "binomial-logit":
+        raise ValueError("gold supports exactly family='binomial-logit'")
+    prior_cols, cov_cols = parse_formula(open("formula.txt").read())
+
+    sids_c, Xcov, y = load_covariates("covariates_train.csv", cov_cols, True)
+    sids_g, vids, G = load_genotypes("genotypes_train.tsv")
+    order = [{s: i for i, s in enumerate(sids_g)}[s] for s in sids_c]
+    G = G[order].astype(np.float64)
+
+    p = G.shape[1]
+
+    _, md = load_metadata("variant_metadata.tsv")
+    _, uniq = build_class_design(vids, md)
+    M = build_membership(vids, md, uniq)
+
+    # Continuous annotations: ONLY the columns the formula names. Unlisted
+    # metadata columns are not ours to use, and the decoy categories ship
+    # columns that are pure noise -- EB is what decides a decoy's gamma is ~0.
+    # variant_class is the categorical class design (build_class_design) and
+    # prior_class_members / prior_class_membership are the fractional soft-membership
+    # columns (build_membership). NONE of the three is a continuous annotation, so
+    # they must be skipped here -- otherwise continuous_annotation float()s a class
+    # list like 'inversion_bnd_complex,duplication_short' and the reference crashes,
+    # which is exactly what broke soft_membership anchor construction.
+    _MEMBERSHIP_COLS = ("variant_class", "prior_class_members", "prior_class_membership")
+    ann_cols, ann_list = [], []
+    for col in prior_cols:
+        if col in _MEMBERSHIP_COLS:
+            continue
+        vec, ok = continuous_annotation(vids, md, col)
+        if ok:
+            ann_cols.append(col)
+            ann_list.append(vec)
+    A = np.column_stack(ann_list) if ann_list else np.zeros((p, 0))
+
+    inner_train, inner_validation = deterministic_stratified_inner_split(sids_c, y)
+
+    # Hierarchical candidate on the inner training rows only.
+    G_inner, inner_mean, inner_sd = standardize(G[inner_train])
+    alpha_inner, beta_inner, recovered_inner = fit_eb(
+        G_inner,
+        Xcov[inner_train],
+        y[inner_train],
+        M,
+        A,
+        uniq,
+        deadline_s=INNER_HIERARCHICAL_DEADLINE_S,
+        n_outer=HIERARCHICAL_OUTER_ITERATIONS,
+    )
+    if (
+        recovered_inner["iterations_run"] != HIERARCHICAL_OUTER_ITERATIONS
+        or recovered_inner["deadline_reached"]
+    ):
+        raise TimeoutError("hierarchical inner candidate missed its selection reserve")
+    hierarchical_inner_model = {
+        "alpha": alpha_inner,
+        "beta": beta_inner,
+        "gmean": inner_mean,
+        "gsd": inner_sd,
+    }
+    hierarchical_validation_logits = linear_predict(
+        hierarchical_inner_model, G[inner_validation], Xcov[inner_validation]
+    )
+    hierarchical_auc = auc(y[inner_validation], hierarchical_validation_logits)
+
+    # Every predeclared ridge penalty must converge.  Selecting from a partial grid
+    # would be a different family protocol, so a missed selection reserve is fatal.
+    ridge_trials = []
+    ridge_validation_logits = []
+    selection_deadline = time.monotonic() + max(
+        SELECTION_DEADLINE_S - _elapsed(), 0.0
+    )
+    for penalty in RIDGE_PENALTIES:
+        candidate = fit_ridge_logistic(
+            G[inner_train],
+            Xcov[inner_train],
+            y[inner_train],
+            penalty,
+            deadline=selection_deadline,
+        )
+        candidate_logits = linear_predict(
+            candidate, G[inner_validation], Xcov[inner_validation]
+        )
+        candidate_auc = auc(y[inner_validation], candidate_logits)
+        ridge_trials.append(candidate_auc)
+        ridge_validation_logits.append(candidate_logits)
+    if _elapsed() >= SELECTION_DEADLINE_S:
+        raise TimeoutError("best-of-family selection exhausted its full-refit reserve")
+    ridge_index = max(range(len(ridge_trials)), key=ridge_trials.__getitem__)
+    ridge_auc = ridge_trials[ridge_index]
+    ridge_penalty = RIDGE_PENALTIES[ridge_index]
+    method = (
+        "ridge_logistic"
+        if ridge_auc > hierarchical_auc + FAMILY_WIN_MARGIN
+        else "hierarchical_eb"
+    )
+
+    # The family selector is rank-based (AUC), but the public task requires calibrated
+    # probabilities and the reward's proper-score factor is reference-relative. Learn
+    # one positive-slope Platt map on the same deterministic TRAINING-only validation
+    # slice used for selection. The positive slope preserves the selected model's AUC;
+    # the intercept and temperature correct its raw-logit probability scale. Held-out
+    # prediction rows and truth remain unopened until after every fit is complete.
+    selected_validation_logits = (
+        hierarchical_validation_logits
+        if method == "hierarchical_eb"
+        else ridge_validation_logits[ridge_index]
+    )
+    calibration = fit_platt_calibrator(
+        selected_validation_logits,
+        y[inner_validation],
+        deadline=selection_deadline,
+    )
+    if _elapsed() >= SELECTION_DEADLINE_S:
+        raise TimeoutError("best-of-family calibration exhausted its full-refit reserve")
+    selection_seconds = _elapsed()
+
+    # Refit the selected family member from scratch on all public training rows.
+    full_refit_started = time.monotonic()
+    if method == "hierarchical_eb":
+        Gstd, gmean, gsd = standardize(G)
+        alpha, beta_g, recovered = fit_eb(
+            Gstd,
+            Xcov,
+            y,
+            M,
+            A,
+            uniq,
+            deadline_s=FIT_COMPUTE_DEADLINE_S,
+            n_outer=HIERARCHICAL_OUTER_ITERATIONS,
+        )
+        if (
+            recovered["iterations_run"] != HIERARCHICAL_OUTER_ITERATIONS
+            or recovered["deadline_reached"]
+        ):
+            raise TimeoutError("hierarchical full refit missed its compute reserve")
+    else:
+        full_deadline = time.monotonic() + max(
+            FIT_COMPUTE_DEADLINE_S - _elapsed(), 0.0
+        )
+        ridge = fit_ridge_logistic(
+            G, Xcov, y, ridge_penalty, deadline=full_deadline
+        )
+        alpha = ridge["alpha"]
+        beta_g = ridge["beta"]
+        gmean = ridge["gmean"]
+        gsd = ridge["gsd"]
+        recovered = {
+            "ridge_penalty": float(ridge_penalty),
+            "ridge_iterations": int(ridge["iterations"]),
+            "ridge_relative_gradient": float(ridge["relative_gradient"]),
+        }
+    full_refit_seconds = time.monotonic() - full_refit_started
+
+    if _elapsed() >= FIT_BUDGET_S:
+        raise TimeoutError("best-of-family refit exhausted its serialization reserve")
+
+    json.dump(
+        {
+            "runtime": {"numpy_version": np.__version__},
+            "family": family,
+            "cov_cols": cov_cols,
+            "alpha": alpha.tolist(),
+            "beta": beta_g.tolist(),
+            "gmean": gmean.tolist(),
+            "gsd": gsd.tolist(),
+            "vids": list(vids),
+            "calibration_intercept": float(calibration["intercept"]),
+            "calibration_slope": float(calibration["slope"]),
+            "calibration_iterations": int(calibration["iterations"]),
+            "calibration_relative_gradient": float(calibration["relative_gradient"]),
+            "ann_cols": ann_cols,
+            "classes": list(uniq),
+            "recovered": recovered,
+            "reference_method": method,
+            "inner_selection_auc": {
+                "hierarchical_eb": float(hierarchical_auc),
+                "ridge_logistic": float(ridge_auc),
+            },
+            "inner_ridge_trials": [
+                {"penalty": float(penalty), "auc": float(trial_auc)}
+                for penalty, trial_auc in zip(RIDGE_PENALTIES, ridge_trials)
+            ],
+            "inner_hierarchical_recovered": recovered_inner,
+            "selection_seconds": float(selection_seconds),
+            "full_refit_seconds": float(full_refit_seconds),
+            "fit_seconds": _elapsed(),
+        },
+        open("model.out", "w"),
+    )
+
+
+def _irls_woodbury(Gstd, W, y, tau2, *, deadline_s, n_irls=30):
+    """Penalized IRLS for [W | Gstd]; covariates unpenalized, genotypes get
+    prior variance tau2. Solved in the n-dimensional dual (Woodbury), which is
+    exact and ~ (p/n)^3 cheaper when p > n.
+
+    Returns (coef, post_var_genotypes, deadline_reached).
+    """
+    n, p = Gstd.shape
+    kw = W.shape[1]
+    coef = np.zeros(kw + p)
+
+    deadline_reached = False
+    for _ in range(n_irls):
+        eta = W @ coef[:kw] + Gstd @ coef[kw:]
+        mu = 1.0 / (1.0 + np.exp(-np.clip(eta, -30, 30)))
+        w = np.clip(mu * (1.0 - mu), 1e-6, None)
+        z = eta + (y - mu) / w
+
+        # Weighted working solve of  min ||sqrt(w)(z - W a - G b)||^2 + sum(b^2/tau2)
+        sw = np.sqrt(w)
+        Gw = Gstd * sw[:, None]
+        Ww = W * sw[:, None]
+        zw = z * sw
+
+        # Dual form: capacitance C = I_n + Gw diag(tau2) Gw'   (n x n)
+        GT = Gw * tau2[None, :]
+        Cap = GT @ Gw.T
+        Cap[np.diag_indices_from(Cap)] += 1.0
+        try:
+            L = np.linalg.cholesky(Cap)
+        except np.linalg.LinAlgError:
+            Cap[np.diag_indices_from(Cap)] += 1e-6
+            L = np.linalg.cholesky(Cap)
+
+        def cap_solve(B):
+            return np.linalg.solve(L.T, np.linalg.solve(L, B))
+
+        # Profile out the unpenalized block: with S = (I + Gw T Gw')^-1 acting as
+        # the whitener, solve the covariate GLS then the genotype dual.
+        SW = cap_solve(Ww)
+        Sz = cap_solve(zw)
+        Acov = Ww.T @ SW
+        Acov[np.diag_indices_from(Acov)] += 1e-10
+        a_new = np.linalg.solve(Acov, Ww.T @ Sz)
+        r = zw - Ww @ a_new
+        b_new = tau2 * (Gw.T @ cap_solve(r))
+
+        step = np.concatenate([a_new, b_new]) - coef
+        coef = coef + step
+        if np.max(np.abs(step)) < 1e-7:
+            break
+        # The outer-loop guard alone cannot bound the wall clock: one IRLS sweep
+        # at the shipped shape is seconds, so an outer iteration can overshoot the
+        # cap on its own. A fit killed mid-iteration writes nothing and scores as
+        # invalid, so the deadline has to bind here too.
+        if _elapsed() > deadline_s:
+            deadline_reached = True
+            break
+
+    # Posterior variance diagonal, from the SAME Cholesky the solve already paid
+    # for:  diag((Gw'Gw + D)^-1) = diag(T - T Gw' Cap^-1 Gw T), T = diag(tau2).
+    GT = Gw * tau2[None, :]                    # (n x p)
+    Q = cap_solve(GT)                          # (n x p)
+    post_var = np.maximum(tau2 - np.einsum("ij,ij->j", GT, Q), 0.0)
+    return coef, post_var, deadline_reached
+
+
+def fit_eb(Gstd, Xcov, y, M, A, uniq, *, deadline_s, n_outer=HIERARCHICAL_OUTER_ITERATIONS):
+    """Empirical-Bayes outer loop over the prior hyperparameters."""
+    n, p = Gstd.shape
+    W = np.hstack([np.ones((n, 1)), Xcov])
+    kw = W.shape[1]
+    C = M.shape[1]
+    q = A.shape[1]
+    MtM = M.T @ M + 1e-6 * np.eye(C)
+
+    log_s = np.zeros(C)
+    gamma = np.zeros(q)
+    lam = np.ones(p)
+    # global2 is prior variance PER VARIANT, so the total prior variance it implies
+    # on the logit scale is ~ p * global2. Starting it at 1.0 asserts a total of
+    # ~2500 for a trait whose reference AUC is ~0.64 -- absurd by three orders of
+    # magnitude, and the damped updates below then spend the whole iteration budget
+    # crawling back down. Measured: from global2=1.0 the loop was still descending
+    # at iteration 7 (tau2_med 0.079, i.e. a prior SD of 0.28 PER standardized
+    # variant), so the fit that got serialized was massively under-shrunk, fit
+    # noise, and scored BELOW a covariates-only GLM. Start where a polygenic trait
+    # actually lives: total prior variance of order 1, spread over p variants.
+    global2 = 1.0 / max(p, 1)
+
+    def baseline_var():
+        sv = np.exp(np.clip(M @ log_s, -12, 12))
+        mod = np.exp(np.clip(A @ gamma, -12, 12)) if q else 1.0
+        return np.maximum(global2 * sv**2 * mod, 1e-10)
+
+    coef = np.zeros(kw + p)
+    deadline_reached = False
+    for _ in range(n_outer):
+        bvar = baseline_var()
+        tau2 = np.maximum(bvar * lam, 1e-10)
+        coef, post_var, irls_deadline_reached = _irls_woodbury(
+            Gstd, W, y, tau2, deadline_s=deadline_s
+        )
+        deadline_reached = deadline_reached or irls_deadline_reached
+
+        b2 = coef[kw:] ** 2 + post_var
+        bvar = baseline_var()
+        lam = np.clip(0.5 * lam + 0.5 * (b2 / np.maximum(bvar, 1e-10)), 1e-6, 1e6)
+
+        mod = np.exp(np.clip(A @ gamma, -12, 12)) if q else np.ones(p)
+        denom = np.maximum(global2 * mod * lam, 1e-12)
+        target = np.log(np.maximum(b2, 1e-12)) - np.log(denom)
+        if not np.all(np.isfinite(target)):
+            raise ValueError("hierarchical class-scale update became non-finite")
+        target = np.clip(target, -24, 24)
+        log_s = np.clip(0.5 * log_s + 0.5 * (0.5 * np.linalg.solve(MtM, M.T @ target)), -12, 12)
+        log_s = log_s - float(np.mean(log_s))    # class scales carry SHAPE only ...
+
+        # ... and the LEVEL is set here, by the closed-form empirical-Bayes moment
+        # update rather than by a damped fixed-point step. global2 is the one
+        # hyperparameter whose scale is both unknown a priori and enormously
+        # consequential (it multiplies every variant's prior variance), so folding
+        # it through the same 0.5-damped recursion as everything else made its
+        # convergence geometric: measured from the old global2=1.0 start, the loop
+        # was still descending at iteration 7 and serialized a fit that was still
+        # ~2 orders of magnitude under-shrunk. E[beta_j^2] = tau2_j at the EB fixed
+        # point, so the level that satisfies that in one step is just the mean of
+        # b2 over its own baseline -- no damping needed, and it lands immediately
+        # instead of asymptotically.
+        sv2 = np.exp(np.clip(2.0 * (M @ log_s), -24, 24))
+        mod_now = np.exp(np.clip(A @ gamma, -12, 12)) if q else np.ones(p)
+        unit_var = np.maximum(sv2 * mod_now * lam, 1e-12)
+        global2 = float(np.clip(np.mean(b2 / unit_var), 1e-12, 1e6))
+
+        if q:
+            sv = np.exp(np.clip(M @ log_s, -12, 12))
+            base_wo = np.maximum(global2 * sv**2 * lam, 1e-12)
+            resp = np.log(np.maximum(b2, 1e-12)) - np.log(base_wo)
+            if not np.all(np.isfinite(resp)):
+                raise ValueError("hierarchical annotation update became non-finite")
+            resp = np.clip(resp, -24, 24)
+            AtA = A.T @ A + 1e-6 * np.eye(q)
+            gamma = np.clip(0.5 * gamma + 0.5 * (0.5 * np.linalg.solve(AtA, A.T @ resp)), -3.0, 3.0)
+
+        if _elapsed() > deadline_s:
+            deadline_reached = True
+            break
+
+    recovered = {
+        "log_s": {str(u): float(log_s[i]) for i, u in enumerate(uniq)},
+        "gamma": gamma.tolist(),
+        "global_scale": float(np.sqrt(global2)),
+        "iterations_run": int(_ + 1),
+        "deadline_reached": bool(deadline_reached),
+    }
+    return coef[:kw], coef[kw:], recovered
+
+
+if __name__ == "__main__":
+    main()
