@@ -0,0 +1,529 @@
+"""IO + design helpers shared by the gold submission's fit and predict.
+
+Formula parsing, CSV/TSV reading, class design, fractional class membership,
+standardization, the deterministic public inner split, exact AUC, and the
+standalone fixed-ridge candidate. The heavier hierarchical estimator remains in
+``gold/fit``; predict imports this module without executing any fitting work.
+"""
+from __future__ import annotations
+
+import hashlib
+import re
+import time
+
+import numpy as np
+
+
+# Forty percent gives the two-family selector and two-parameter calibrator enough
+# independent public-training evidence to avoid noisy family flips. The winning
+# estimator is still refit on every training row, so this does not discard final-fit data.
+INNER_VALIDATION_FRACTION = 0.4
+INNER_SPLIT_SEED = 20260718
+RIDGE_PENALTIES = (0.3, 0.1, 0.03, 0.01, 0.003, 0.001)
+# The family decision is estimated on public-training validation rows. Ridge must
+# clear a real uncertainty guard rather than win on sampling noise; otherwise the
+# structured hierarchical incumbent is retained. Dense Gaussian regimes clear 0.03
+# comfortably, while noisy near-ties no longer flip to a brittle reference family.
+FAMILY_WIN_MARGIN = 0.03
+PLATT_MAX_ITERATIONS = 100
+PLATT_RELATIVE_GRADIENT_TOLERANCE = 1e-8
+# The inner validation slice is only ~20% of training and can be nearly separated.
+# A real ridge is necessary: an epsilon penalty lets the slope explode, saturating
+# held-out probabilities and destroying both proper scores and floating-point rank
+# resolution. This fixed, public value regularizes only the two calibration parameters.
+PLATT_L2 = 1e-3
+PLATT_MINIMUM_SLOPE = 1e-8
+
+
+def _split_terms(inner):
+    """Split a `pgs(...)` / `covariate(...)` body on EITHER separator.
+
+    The formula grammar allows `+` or `,` between names, either may appear, and
+    both may appear in the same corpus. Splitting on one separator only (the
+    older helper split pgs() on `+` and covariate() on `,`) silently collapses a
+    comma-separated list into a single bogus column name like 'age, sex, pc1',
+    which then matches no column -- so the model quietly drops every covariate
+    instead of failing loudly. Treat the two separators identically.
+    """
+    return [t.strip() for t in re.split(r"[+,]", inner) if t.strip()]
+
+
+def parse_formula(text):
+    """y ~ pgs(a + b) + covariate(c, d)  ->  (prior_cols, cov_cols)."""
+    prior_cols, cov_cols = [], []
+    rhs = text.split("~", 1)[1] if "~" in text else text
+    m = re.search(r"pgs\(([^)]*)\)", rhs)
+    if m:
+        prior_cols = _split_terms(m.group(1))
+    m = re.search(r"covariate\(([^)]*)\)", rhs)
+    if m:
+        cov_cols = _split_terms(m.group(1))
+    return prior_cols, cov_cols
+
+
+def read_csv(path):
+    with open(path) as fh:
+        header = fh.readline().strip().split(",")
+        rows = [ln.rstrip("\n").split(",") for ln in fh if ln.strip()]
+    return header, rows
+
+
+def read_tsv(path):
+    with open(path) as fh:
+        header = fh.readline().strip().split("\t")
+        rows = [ln.rstrip("\n").split("\t") for ln in fh if ln.strip()]
+    return header, rows
+
+
+def load_genotypes(path):
+    header, rows = read_tsv(path)
+    vids = header[1:]
+    sids = [r[0] for r in rows]
+    G = np.array([[float(x) for x in r[1:]] for r in rows], dtype=np.float64)
+    return sids, vids, G
+
+
+def load_covariates(path, cov_cols, want_y):
+    header, rows = read_csv(path)
+    idx = {h: i for i, h in enumerate(header)}
+    sids = [r[idx["sample_id"]] for r in rows]
+    X = np.array([[float(r[idx[c]]) for c in cov_cols] for r in rows], dtype=np.float64)
+    y = None
+    if want_y and "y" in idx:
+        y = np.array([float(r[idx["y"]]) for r in rows], dtype=np.float64)
+    return sids, X, y
+
+
+def load_metadata(path):
+    header, rows = read_tsv(path)
+    idx = {h: i for i, h in enumerate(header)}
+    md = {}
+    for r in rows:
+        md[r[idx["variant_id"]]] = {h: r[i] for h, i in idx.items()}
+    return header, md
+
+
+def build_class_design(vids, md):
+    """Return per-variant class label array + sorted class list."""
+    classes = [md[v]["variant_class"] for v in vids]
+    if any(not value for value in classes):
+        raise ValueError("variant_class must be present for every public variant")
+    uniq = sorted(set(classes))
+    return np.array(classes), uniq
+
+
+def build_membership(vids, md, uniq):
+    """Fractional class-membership matrix M (P x C).
+
+    Default = hard 1-of-C from variant_class. If the metadata carries
+    `prior_class_members` (comma list of class tokens) + `prior_class_membership`
+    (comma list of weights), use the fractional membership -- this is what the
+    soft_membership datasets are generated from, so a model that honors it prices
+    those variants' priors correctly (a hard classifier cannot)."""
+    cidx = {c: i for i, c in enumerate(uniq)}
+    P, C = len(vids), len(uniq)
+    M = np.zeros((P, C))
+    for j, v in enumerate(vids):
+        rec = md[v]
+        members_present = "prior_class_members" in rec
+        weights_present = "prior_class_membership" in rec
+        if members_present is not weights_present:
+            raise ValueError("soft-membership columns must appear together")
+        members = rec["prior_class_members"] if members_present else ""
+        weights = rec["prior_class_membership"] if weights_present else ""
+        if members_present and (not members or not weights):
+            raise ValueError("soft-membership values must be non-empty")
+        used = False
+        if members and weights:
+            toks = [t.strip() for t in members.split(",") if t.strip()]
+            ws = [float(x) for x in weights.split(",")]
+            if (
+                not toks or len(toks) != len(ws)
+                or any(t not in cidx for t in toks)
+                or any(not np.isfinite(w) or w < 0.0 for w in ws)
+                or not np.isclose(sum(ws), 1.0, rtol=0.0, atol=1e-6)
+            ):
+                raise ValueError("soft class membership is invalid")
+            for t, w in zip(toks, ws):
+                M[j, cidx[t]] += w
+                used = True
+        if not used:
+            c = rec["variant_class"]
+            if c not in cidx:
+                raise ValueError("variant class is outside the declared class design")
+            M[j, cidx[c]] = 1.0
+    return M
+
+
+def continuous_annotation(vids, md, col):
+    """Standardized continuous annotation vector (0 if absent)."""
+    vals = []
+    for v in vids:
+        if col not in md[v]:
+            raise ValueError(f"formula annotation {col!r} is missing")
+        s = md[v][col]
+        try:
+            vals.append(float(s))
+        except (ValueError, TypeError) as exc:
+            raise ValueError(f"formula annotation {col!r} is invalid") from exc
+    x = np.array(vals)
+    if x.std() < 1e-9:
+        return np.zeros(len(vids)), False
+    return (x - x.mean()) / (x.std() + 1e-12), True
+
+
+def standardize(G):
+    mean = G.mean(0)
+    css = ((G - mean) ** 2).sum(0)
+    sd = np.sqrt(css / G.shape[0])
+    sd = np.where(sd < 1e-6, 1.0, sd)
+    return (G - mean) / sd, mean, sd
+
+
+def deterministic_stratified_inner_split(sample_ids, targets):
+    """Exact public-training split used by the shipped family selector.
+
+    Rows are ranked independently within each outcome class by SHA-256 of the
+    public sample id and the fixed protocol seed.  No filesystem path, row
+    position, category label, or held-out value participates in selection.
+    """
+    ids = tuple(sample_ids)
+    y = np.asarray(targets, dtype=np.float64).reshape(-1)
+    if len(ids) != y.size or len(ids) < 4 or len(set(ids)) != len(ids):
+        raise ValueError("inner split inputs have inconsistent or duplicate rows")
+    if any(not isinstance(value, str) or not value for value in ids):
+        raise ValueError("inner split sample IDs must be non-empty strings")
+    if set(np.unique(y)) != {0.0, 1.0}:
+        raise ValueError("inner split requires both binary outcome classes")
+
+    validation_indices = []
+    for target_value in (0.0, 1.0):
+        class_indices = np.flatnonzero(y == target_value)
+        if class_indices.size < 2:
+            raise ValueError("each class needs at least two inner-split rows")
+
+        def stable_key(index):
+            payload = f"{INNER_SPLIT_SEED}\0{ids[index]}".encode("utf-8")
+            return hashlib.sha256(payload).digest(), ids[index]
+
+        ranked = sorted((int(index) for index in class_indices), key=stable_key)
+        count = int(round(INNER_VALIDATION_FRACTION * len(ranked)))
+        count = min(max(count, 1), len(ranked) - 1)
+        validation_indices.extend(ranked[:count])
+
+    validation = np.asarray(sorted(validation_indices), dtype=np.int64)
+    mask = np.ones(y.size, dtype=bool)
+    mask[validation] = False
+    training = np.flatnonzero(mask).astype(np.int64, copy=False)
+    if set(np.unique(y[training])) != {0.0, 1.0}:
+        raise ValueError("inner training split lost an outcome class")
+    return training, validation
+
+
+def auc(targets, scores):
+    """Binary AUC with stable average ranks for ties (the shipped definition)."""
+    y = np.asarray(targets, dtype=np.float64).reshape(-1)
+    score = np.asarray(scores, dtype=np.float64).reshape(-1)
+    if y.size != score.size or not np.all(np.isfinite(score)):
+        raise ValueError("AUC inputs are invalid")
+    order = np.argsort(score, kind="mergesort")
+    ordered = score[order]
+    ranks_ordered = np.arange(1, score.size + 1, dtype=np.float64)
+    start = 0
+    while start < score.size:
+        end = start
+        while end + 1 < score.size and ordered[end + 1] == ordered[start]:
+            end += 1
+        if end > start:
+            ranks_ordered[start:end + 1] = (start + 1 + end + 1) / 2.0
+        start = end + 1
+    ranks = np.empty(score.size, dtype=np.float64)
+    ranks[order] = ranks_ordered
+    positives = float(np.sum(y == 1.0))
+    negatives = float(np.sum(y == 0.0))
+    if positives == 0.0 or negatives == 0.0:
+        raise ValueError("AUC needs both outcome classes")
+    return float(
+        (np.sum(ranks[y == 1.0]) - positives * (positives + 1.0) / 2.0)
+        / (positives * negatives)
+    )
+
+
+def fit_platt_calibrator(logits, targets, *, deadline=None):
+    """Fit a deterministic two-parameter Platt map on training-only logits.
+
+    The returned map is ``sigmoid(intercept + slope * raw_logit)``.  The
+    optimizer works on standardized logits for conditioning, then translates
+    the coefficients back to the raw-logit scale.  A tiny fixed L2 term makes
+    the Newton system well-defined under near-separation without materially
+    changing the calibration target.  Backtracking enforces descent and a
+    strictly positive slope, so calibration preserves the selected model's
+    ranking (and therefore its AUC).  Invalid, unidentifiable, non-converged, or
+    non-positive-slope fits fail closed; there is no identity-map fallback.
+    """
+    score = np.asarray(logits, dtype=np.float64).reshape(-1)
+    y = np.asarray(targets, dtype=np.float64).reshape(-1)
+    if (
+        score.size != y.size
+        or score.size < 4
+        or not np.all(np.isfinite(score))
+        or not np.all(np.isfinite(y))
+        or set(np.unique(y)) != {0.0, 1.0}
+    ):
+        raise ValueError("Platt calibration requires finite logits and both binary classes")
+    score_mean = float(np.mean(score))
+    score_scale = float(np.std(score))
+    if not np.isfinite(score_scale) or score_scale <= 1e-12:
+        raise ValueError("Platt calibration logits have no identifiable scale")
+    standardized = (score - score_mean) / score_scale
+    design = np.column_stack([np.ones(score.size, dtype=np.float64), standardized])
+
+    prevalence = float(np.mean(y))
+    coefficients = np.asarray(
+        [np.log(prevalence / (1.0 - prevalence)), 1.0], dtype=np.float64
+    )
+
+    def objective_gradient_hessian(candidate):
+        eta = design @ candidate
+        probability = 1.0 / (1.0 + np.exp(-np.clip(eta, -40.0, 40.0)))
+        value = float(
+            np.mean(np.logaddexp(0.0, eta) - y * eta)
+            + 0.5 * PLATT_L2 * np.dot(candidate, candidate)
+        )
+        gradient = design.T @ (probability - y) / y.size + PLATT_L2 * candidate
+        weight = probability * (1.0 - probability)
+        hessian = (design.T * weight) @ design / y.size
+        hessian += PLATT_L2 * np.eye(2, dtype=np.float64)
+        return value, gradient, hessian
+
+    initial_gradient_norm = None
+    relative_gradient = float("inf")
+    converged = False
+    for iteration in range(PLATT_MAX_ITERATIONS):
+        if deadline is not None and time.monotonic() >= deadline:
+            raise TimeoutError("Platt calibration exceeded its fit-time reserve")
+        value, gradient, hessian = objective_gradient_hessian(coefficients)
+        gradient_norm = float(np.linalg.norm(gradient))
+        if initial_gradient_norm is None:
+            initial_gradient_norm = max(gradient_norm, 1e-30)
+        relative_gradient = gradient_norm / initial_gradient_norm
+        if relative_gradient <= PLATT_RELATIVE_GRADIENT_TOLERANCE:
+            converged = True
+            break
+        try:
+            direction = -np.linalg.solve(hessian, gradient)
+        except np.linalg.LinAlgError as exc:
+            raise ValueError("Platt calibration Newton system is singular") from exc
+        directional_derivative = float(np.dot(gradient, direction))
+        if (
+            not np.all(np.isfinite(direction))
+            or not np.isfinite(directional_derivative)
+            or directional_derivative >= 0.0
+        ):
+            raise ValueError("Platt calibration Newton direction is invalid")
+
+        step = 1.0
+        if direction[1] < 0.0:
+            positive_step = (
+                coefficients[1] - PLATT_MINIMUM_SLOPE
+            ) / -direction[1]
+            step = min(step, 0.99 * positive_step)
+        accepted = False
+        for _ in range(60):
+            if deadline is not None and time.monotonic() >= deadline:
+                raise TimeoutError("Platt calibration exceeded its fit-time reserve")
+            proposal = coefficients + step * direction
+            if proposal[1] > PLATT_MINIMUM_SLOPE and np.all(np.isfinite(proposal)):
+                proposal_value = objective_gradient_hessian(proposal)[0]
+                if proposal_value <= value + 1e-4 * step * directional_derivative:
+                    coefficients = proposal
+                    accepted = True
+                    break
+            step *= 0.5
+        if not accepted:
+            raise ValueError("Platt calibration backtracking failed")
+    if not converged:
+        raise ValueError(
+            "Platt calibration did not converge "
+            f"(relative gradient {relative_gradient:.3g})"
+        )
+
+    slope = float(coefficients[1] / score_scale)
+    intercept = float(coefficients[0] - coefficients[1] * score_mean / score_scale)
+    if (
+        not np.isfinite(intercept)
+        or not np.isfinite(slope)
+        or slope <= 0.0
+    ):
+        raise ValueError("Platt calibration produced invalid raw-logit coefficients")
+    return {
+        "intercept": intercept,
+        "slope": slope,
+        "iterations": int(iteration + 1),
+        "relative_gradient": float(relative_gradient),
+    }
+
+
+def fit_ridge_logistic(genotypes, covariates, targets, penalty, *, deadline=None):
+    """Fit the selector's fixed-penalty ridge logistic candidate from scratch.
+
+    This is a standalone NumPy implementation of the public estimator contract:
+    standardized genotypes, standardized nuisance covariates, an unpenalized
+    intercept, 1e-8 nuisance L2, and FISTA with the shipped 500-iteration/1e-5
+    convergence controls.  A missed deadline is an error; silently selecting from
+    an incomplete penalty grid would no longer reproduce best-of-family.
+    """
+    G = np.asarray(genotypes, dtype=np.float64)
+    C = np.asarray(covariates, dtype=np.float64)
+    y = np.asarray(targets, dtype=np.float64).reshape(-1)
+    if (
+        G.ndim != 2
+        or C.ndim != 2
+        or G.shape[0] != C.shape[0]
+        or G.shape[0] != y.size
+        or set(np.unique(y)) != {0.0, 1.0}
+        or not np.all(np.isfinite(G))
+        or not np.all(np.isfinite(C))
+        or not np.isfinite(penalty)
+        or penalty <= 0.0
+    ):
+        raise ValueError("ridge candidate received invalid public training data")
+
+    def ridge_standardize(values):
+        mean = values.mean(axis=0)
+        centered = values - mean
+        scale = np.sqrt(
+            np.einsum("ij,ij->j", centered, centered) / max(values.shape[0], 1)
+        )
+        scale = np.where(scale < 1e-8, 1.0, scale)
+        return centered / scale, mean, scale
+
+    Gs, gmean, gsd = ridge_standardize(G)
+    Cs, cmean, csd = ridge_standardize(C)
+    nuisance_count = C.shape[1]
+    design = np.empty((y.size, 1 + nuisance_count + G.shape[1]), dtype=np.float64)
+    design[:, 0] = 1.0
+    design[:, 1:1 + nuisance_count] = Cs
+    design[:, 1 + nuisance_count:] = Gs
+    genetic_start = 1 + nuisance_count
+    l2 = np.zeros(design.shape[1], dtype=np.float64)
+    l2[1:genetic_start] = 1e-8
+    l2[genetic_start:] = float(penalty)
+
+    def objective_and_gradient(beta):
+        logits = np.clip(design @ beta, -30.0, 30.0)
+        value = float(
+            np.mean(np.logaddexp(0.0, logits) - y * logits)
+            + 0.5 * np.dot(l2, beta * beta)
+        )
+        probability = 1.0 / (1.0 + np.exp(-logits))
+        gradient = design.T @ (probability - y) / y.size + l2 * beta
+        return value, gradient
+
+    def objective(beta):
+        logits = np.clip(design @ beta, -30.0, 30.0)
+        return float(
+            np.mean(np.logaddexp(0.0, logits) - y * logits)
+            + 0.5 * np.dot(l2, beta * beta)
+        )
+
+    coefficients = np.zeros(design.shape[1], dtype=np.float64)
+    extrapolated = coefficients.copy()
+    acceleration = 1.0
+    lipschitz = 1.0
+    initial_gradient_norm = np.linalg.norm(
+        objective_and_gradient(coefficients)[1]
+    ) + 1e-30
+    converged = False
+    relative_gradient = float("inf")
+    for iteration in range(500):
+        if deadline is not None and time.monotonic() >= deadline:
+            raise TimeoutError("ridge family selection exceeded its fit-time reserve")
+        value, gradient = objective_and_gradient(extrapolated)
+        trial = max(lipschitz * 0.5, 1e-8)
+        while True:
+            proposal = extrapolated - gradient / trial
+            difference = proposal - extrapolated
+            bound = (
+                value
+                + float(np.dot(gradient, difference))
+                + 0.5 * trial * float(np.dot(difference, difference))
+            )
+            if objective(proposal) <= bound + 1e-12:
+                break
+            trial *= 2.0
+            if not np.isfinite(trial):
+                raise ValueError("ridge candidate backtracking diverged")
+        lipschitz = trial
+        if float(np.dot(extrapolated - proposal, proposal - coefficients)) > 0.0:
+            acceleration = 1.0
+        next_acceleration = 0.5 * (
+            1.0 + np.sqrt(1.0 + 4.0 * acceleration * acceleration)
+        )
+        extrapolated = proposal + ((acceleration - 1.0) / next_acceleration) * (
+            proposal - coefficients
+        )
+        coefficients = proposal
+        acceleration = next_acceleration
+        relative_gradient = float(
+            np.linalg.norm(objective_and_gradient(coefficients)[1])
+            / initial_gradient_norm
+        )
+        if relative_gradient <= 1e-5:
+            converged = True
+            break
+    if not converged:
+        raise ValueError(
+            f"ridge candidate did not converge at penalty {penalty:g} "
+            f"(relative gradient {relative_gradient:.3g})"
+        )
+
+    covariate_coefficients = coefficients[1:genetic_start] / csd
+    intercept = float(coefficients[0] - np.dot(cmean, covariate_coefficients))
+    return {
+        "alpha": np.concatenate([[intercept], covariate_coefficients]),
+        "beta": coefficients[genetic_start:],
+        "gmean": gmean,
+        "gsd": gsd,
+        "iterations": int(iteration + 1),
+        "relative_gradient": relative_gradient,
+    }
+
+
+def linear_predict(model, genotypes, covariates):
+    """Apply either standalone family candidate on its standardized axes."""
+    G = np.asarray(genotypes, dtype=np.float64)
+    C = np.asarray(covariates, dtype=np.float64)
+    standardized = (G - np.asarray(model["gmean"])) / np.asarray(model["gsd"])
+    nuisance = np.hstack([np.ones((G.shape[0], 1)), C])
+    logits = nuisance @ np.asarray(model["alpha"]) + standardized @ np.asarray(model["beta"])
+    if not np.all(np.isfinite(logits)):
+        raise ValueError("family candidate produced non-finite logits")
+    return np.asarray(logits, dtype=np.float64)
+
+
+def predict_probability(model, genotypes, covariates):
+    """Authoritative probability postprocessing for gold and corpus anchors."""
+    logits = linear_predict(model, genotypes, covariates)
+    try:
+        calibration_intercept = float(model["calibration_intercept"])
+        calibration_slope = float(model["calibration_slope"])
+    except (KeyError, TypeError, ValueError) as exc:
+        raise ValueError("public reference calibration coefficients are missing or invalid") from exc
+    if (
+        not np.isfinite(calibration_intercept)
+        or not np.isfinite(calibration_slope)
+        or calibration_slope <= 0.0
+    ):
+        raise ValueError("public reference calibration coefficients are invalid")
+    calibrated_logits = calibration_intercept + calibration_slope * logits
+    if not np.all(np.isfinite(calibrated_logits)):
+        raise ValueError("public reference produced non-finite calibrated logits")
+    # Keep probabilities strictly inside (0, 1), even for extreme extrapolation.
+    # The selected model's ranking is determined before this monotone numerical guard.
+    probability = 1.0 / (
+        1.0 + np.exp(-np.clip(calibrated_logits, -30.0, 30.0))
+    )
+    if not np.all(np.isfinite(probability)):
+        raise ValueError("public reference produced non-finite probabilities")
+    return np.asarray(probability, dtype=np.float64)
