+#!/opt/svpgs-venv/bin/python
+"""GOLD predict: apply the selected public family model to the held-out cohort.
+
+Both hierarchical empirical Bayes and ridge serialize the same linear-logit
+representation and a training-only positive-slope Platt map, so prediction is a
+standardization, two dot products, and an affine logit calibration. It aligns the test
+genotype columns to the variant order the fit serialized (never assuming the
+test file repeats the training column layout) and emits a calibrated probability
+per test row, in input order.
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+from pgs_core import load_covariates, load_genotypes, predict_probability  # noqa: E402
+
+
+def main() -> None:
+    model = json.load(open("model.out"))
+    cov_cols = model["cov_cols"]
+    sids_c, Xcov, _ = load_covariates("covariates_test.csv", cov_cols, False)
+    sids_g, vids, G = load_genotypes("genotypes_test.tsv")
+
+    order = [{s: i for i, s in enumerate(sids_g)}[s] for s in sids_c]
+    G = G[order].astype(np.float64)
+
+    # Align by public variant ID, but fail closed if the two files do not contain
+    # the exact same unique set. Zero-filling a missing fitted variant would be a
+    # different model and would conceal a broken task contract.
+    fit_vids = model["vids"]
+    if len(set(vids)) != len(vids) or len(set(fit_vids)) != len(fit_vids):
+        raise ValueError("prediction or fitted variant IDs are duplicated")
+    if set(fit_vids) != set(vids):
+        raise ValueError("prediction variant IDs do not match the fitted model")
+    if list(fit_vids) != list(vids):
+        pos = {v: j for j, v in enumerate(vids)}
+        G = G[:, [pos[v] for v in fit_vids]]
+
+    mean = predict_probability(model, G, Xcov)
+
+    with open("pred.csv", "w") as fh:
+        fh.write("mean\n")
+        for value in mean:
+            # Seventeen significant digits round-trip a float64, so the packaged
+            # witness and the builder score the same probabilities rather than a
+            # separately rounded approximation.
+            fh.write(f"{value:.17g}\n")
+
+
+if __name__ == "__main__":
+    main()
