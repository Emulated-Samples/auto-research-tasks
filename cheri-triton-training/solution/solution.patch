+	# Stats prepass: 3-tap dilated conv + per-N (sum, sq_sum) -> mean / rstd.
+	# Two-stage so the per-N reductions are atomic-free.
+	@triton.autotune(
+		configs=[triton.Config({}, num_warps=nw, num_stages=ns)
