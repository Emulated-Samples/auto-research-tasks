+	@triton.jit
+	def _fwd_inf_stats_kernel(
+		X_ptr, W_ptr, Y_ptr, Sum_ptr, Sq_ptr,
+		stride_xn, dilation,
+		NUM_PARTIALS, N,
+		L: tl.constexpr,
+		C: tl.constexpr,
+		BLOCK_C: tl.constexpr,
+		BLOCK_L: tl.constexpr,
+		WRITE_Y: tl.constexpr,
+	):
+		pid_n = tl.program_id(0)
+		pid_l = tl.program_id(1)
+		offs_c = tl.arange(0, BLOCK_C)[None, :]
+		mask_c = offs_c < C
