+#!/usr/bin/env python3
+"""Reference solution `fit`: learn the block-structured factorization.
+
+Runs the vendored deterministic reference pipeline (spectral subspace +
+symmetric FastICA + isolation-band grouping + ridge-refined additive decoder)
+on the unlabeled training observations and persists the learned model for
+`transform`. Model size and sparsity are inferred from the data and the public
+`max_features` bound only, per the program contract.
+"""
+
+import json
+import pickle
+from pathlib import Path
+
+import numpy as np
+
+from reference_bsf import fit_bsf_reference
+
+MODEL_FILE = "model.pkl"
+
+
+def main() -> None:
+    run_dir = Path.cwd()
+    config = json.loads((run_dir / "config.json").read_text())
+    with np.load(run_dir / "train.npz", allow_pickle=False) as archive:
+        x = np.asarray(archive["x"], dtype=np.float64)
+    model = fit_bsf_reference(x, int(config["max_features"]))
+    with open(run_dir / MODEL_FILE, "wb") as handle:
+        pickle.dump(model, handle, protocol=pickle.HIGHEST_PROTOCOL)
+
+
+if __name__ == "__main__":
+    main()
