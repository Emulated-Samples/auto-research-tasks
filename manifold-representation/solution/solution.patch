+#!/usr/bin/env python3
+"""Reference solution `transform`: deterministic out-of-sample inference.
+
+Loads the model persisted by `fit` (each call starts from the same artifact),
+routes `eval.npz` rows through the learned encoder/decoder, and writes the
+predictions archive named by config.json's `predictions_file` with exactly the
+contract members: reconstruction, presence, contributions, bias. Row-order and
+batch-context independent by construction (pure per-row linear algebra from
+persisted state).
+"""
+
+import json
+import pickle
+from pathlib import Path
+
+import numpy as np
+
+from reference_bsf import transform_bsf_reference
+
+MODEL_FILE = "model.pkl"
+
+
+def main() -> None:
+    run_dir = Path.cwd()
+    config = json.loads((run_dir / "config.json").read_text())
+    with open(run_dir / MODEL_FILE, "rb") as handle:
+        model = pickle.load(handle)
+    with np.load(run_dir / "eval.npz", allow_pickle=False) as archive:
+        x = np.asarray(archive["x"], dtype=np.float64)
+    prediction = transform_bsf_reference(model, x)
+    out = run_dir / str(config["predictions_file"])
+    np.savez(
+        out,
+        reconstruction=prediction.reconstruction,
+        presence=prediction.presence,
+        contributions=prediction.contributions,
+        bias=prediction.bias,
+    )
+    # np.savez appends ".npz" when absent; normalize to the contract name.
+    written = out if out.exists() else out.with_suffix(out.suffix + ".npz")
+    if written != out:
+        written.rename(out)
+
+
+if __name__ == "__main__":
+    main()
